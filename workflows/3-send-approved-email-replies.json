    {
      "id": "send_approved_reply_7",
      "name": "Send Approved Reply",
      "webhookId": "8ccf0610-8b0a-548b-8056-4d16b1716240",
      "notes": "CREDENTIAL: pick your Gmail OAuth2 credential here (same inbox Workflow 2 watches) — left as a placeholder on purpose. Uses the Reply operation against the stored Original Gmail Message ID, which threads the reply into the original conversation automatically. The Reply operation has no separate Thread ID field — n8n derives the thread from the message being replied to, so the Original Gmail Thread ID column exists in Airtable for record-keeping but isn't needed here.",
      "type": "n8n-nodes-base.gmail",
      "typeVersion": 2.2,
      "retryOnFail": true,
      "maxTries": 2,
      "waitBetweenTries": 5000,
      "onError": "continueRegularOutput",
      "position": [
        848,
        0
      ],
      "parameters": {
        "operation": "reply",
        "messageId": "={{ $('Get Approved Unsent Drafts').item.json.fields['Original Gmail Message ID'] }}",
        "emailType": "text",
        "message": "={{ $('Get Approved Unsent Drafts').item.json.fields['Draft Body'] }}",
        "options": {}
      },
      "credentials": {
        "gmailOAuth2": {
          "id": "REPLACE_ME",
          "name": "Gmail account"
        }
      }
    },

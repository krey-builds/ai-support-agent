    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "a0",
              "name": "pageContent",
              "type": "string",
              "value": "={{ 'Question: ' + ($json.fields['Question'] || '') + '\\nAnswer: ' + ($json.fields['Answer'] || '') }}"
            },
            {
              "id": "a1",
              "name": "metadata",
              "type": "object",
              "value": "={{ { category: $json.fields['Category'] || '', airtable_record_id: $json.id } }}"
            }
          ]
        },
        "options": {}
      },
      "id": "build_document_text_11",
      "name": "Build Document Text",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        1408,
        0
      ],
      "notes": "Only pageContent + metadata go downstream on purpose — the Default Data Loader (in 'Load All Input Data' mode) reads exactly these two fields to build the document that gets embedded. metadata.airtable_record_id is what would let a future retrieval be traced back to its source FAQ row."
    },
    {
      "parameters": {},
      "id": "gemini_embeddings_kb_12",
      "name": "Gemini Embeddings (KB)",
      "type": "@n8n/n8n-nodes-langchain.embeddingsGoogleGemini",
      "typeVersion": 1,
      "position": [
        1408,
        272
      ],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 5000,
      "credentials": {
        "googlePalmApi": {
          "id": "REPLACE_ME",
          "name": "Google Gemini API"
        }
      },
      "notes": "Default model (gemini-embedding-001) produces 3072-dimension vectors, confirmed against a real execution 2026-08-22 — n8n's own node description incorrectly claims 768. Your Supabase 'documents' table's embedding column must be vector(3072) or every insert below will fail with a dimension mismatch. CREDENTIAL: select or create \"Google Gemini API\" here — left with no id on purpose, n8n's API auto-attaches an unrelated existing credential of the same type if one is provided by name only."
    },
    {
      "parameters": {
        "options": {}
      },
      "id": "default_data_loader_13",
      "name": "Default Data Loader",
      "type": "@n8n/n8n-nodes-langchain.documentDefaultDataLoader",
      "typeVersion": 1.1,
      "position": [
        1536,
        464
      ],
      "notes": "Simple splitting (1000 chars / 200 overlap) is overkill for one FAQ answer at a time but harmless — a Question+Answer pair almost never reaches 1000 characters, so in practice each row stays a single chunk."
    },
